{
  "rules": [
    {
      "id": "R1",
      "description": "Pressure an aggressive opponent when their opponent is low on HP.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "LowHP", "args": ["?target"]},
        {"predicate": "Aggressive", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "PressureOpponent", "args": ["?actor", "?target"]}
    },
    {
      "id": "R2",
      "description": "Recognize an elemental type advantage over the opponent.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "HasTypeAdvantage", "args": ["?actor", "?target"]}
      ],
      "conclusion": {"predicate": "ExploitTypeAdvantage", "args": ["?actor", "?target"]}
    },
    {
      "id": "R3",
      "description": "Recognize a finishing opportunity against a low-HP opponent.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "LowHP", "args": ["?target"]},
        {"predicate": "HasHighDamagePotential", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "OpportunityToFinish", "args": ["?actor", "?target"]}
    },
    {
      "id": "R4",
      "description": "Recognize an exploitable status effect on the opponent.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "UnderStatusEffect", "args": ["?target"]}
      ],
      "conclusion": {"predicate": "ExploitOpponentStatus", "args": ["?actor", "?target"]}
    },
    {
      "id": "R5",
      "description": "Consider healing oneself when low on HP and a healing move is available.",
      "conditions": [
        {"predicate": "LowHP", "args": ["?actor"]},
        {"predicate": "HasHealingMove", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "ConsiderSelfHealing", "args": ["?actor"]}
    },
    {
      "id": "R6",
      "description": "Convert opponent pressure into a legal attack intent.",
      "conditions": [
        {"predicate": "PressureOpponent", "args": ["?actor", "?target"]},
        {"predicate": "HasDamagingMove", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "ActionIntent", "args": ["?actor", "?target", "ATTACK"]}
    },
    {
      "id": "R7",
      "description": "Convert a known type advantage into a legal attack intent.",
      "conditions": [
        {"predicate": "ExploitTypeAdvantage", "args": ["?actor", "?target"]},
        {"predicate": "HasDamagingMove", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "ActionIntent", "args": ["?actor", "?target", "ATTACK"]}
    },
    {
      "id": "R8",
      "description": "Convert a finishing opportunity into a legal attack intent.",
      "conditions": [
        {"predicate": "OpportunityToFinish", "args": ["?actor", "?target"]},
        {"predicate": "HasDamagingMove", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "ActionIntent", "args": ["?actor", "?target", "ATTACK"]}
    },
    {
      "id": "R9",
      "description": "Convert an exploitable status condition into a legal attack intent.",
      "conditions": [
        {"predicate": "ExploitOpponentStatus", "args": ["?actor", "?target"]},
        {"predicate": "HasDamagingMove", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "ActionIntent", "args": ["?actor", "?target", "ATTACK"]}
    },
    {
      "id": "R10",
      "description": "Convert self-healing consideration into a legal heal intent.",
      "conditions": [
        {"predicate": "ConsiderSelfHealing", "args": ["?actor"]},
        {"predicate": "HasHealingMove", "args": ["?actor"]}
      ],
      "conclusion": {"predicate": "ActionIntent", "args": ["?actor", "?actor", "HEAL"]}
    },
    {
      "id": "P1",
      "description": "Use a living team Pokémon to pressure a low-HP opposing Pokémon.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "Controls", "args": ["?actor", "?actorPokemon"]},
        {"predicate": "Controls", "args": ["?target", "?targetPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?actorPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?targetPokemon"]},
        {"predicate": "LowHP", "args": ["?targetPokemon"]},
        {"predicate": "Aggressive", "args": ["?actor"]},
        {"predicate": "HasDamagingMove", "args": ["?actorPokemon"]}
      ],
      "conclusion": {
        "predicate": "PokemonActionIntent",
        "args": ["?actorPokemon", "?targetPokemon", "ATTACK"]
      }
    },
    {
      "id": "P2",
      "description": "Use the Pokémon with type advantage against its opposing target.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "Controls", "args": ["?actor", "?actorPokemon"]},
        {"predicate": "Controls", "args": ["?target", "?targetPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?actorPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?targetPokemon"]},
        {"predicate": "HasTypeAdvantage", "args": ["?actorPokemon", "?targetPokemon"]},
        {"predicate": "HasDamagingMove", "args": ["?actorPokemon"]}
      ],
      "conclusion": {
        "predicate": "PokemonActionIntent",
        "args": ["?actorPokemon", "?targetPokemon", "ATTACK"]
      }
    },
    {
      "id": "P3",
      "description": "Use a high-damage Pokémon to finish a low-HP opposing Pokémon.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "Controls", "args": ["?actor", "?actorPokemon"]},
        {"predicate": "Controls", "args": ["?target", "?targetPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?actorPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?targetPokemon"]},
        {"predicate": "LowHP", "args": ["?targetPokemon"]},
        {"predicate": "HasHighDamagePotential", "args": ["?actorPokemon"]},
        {"predicate": "HasDamagingMove", "args": ["?actorPokemon"]}
      ],
      "conclusion": {
        "predicate": "PokemonActionIntent",
        "args": ["?actorPokemon", "?targetPokemon", "ATTACK"]
      }
    },
    {
      "id": "P4",
      "description": "Use a damaging move against a living Pokémon with an exploitable status.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?target"]},
        {"predicate": "Controls", "args": ["?actor", "?actorPokemon"]},
        {"predicate": "Controls", "args": ["?target", "?targetPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?actorPokemon"]},
        {"predicate": "AlivePokemon", "args": ["?targetPokemon"]},
        {"predicate": "UnderStatusEffect", "args": ["?targetPokemon"]},
        {"predicate": "HasDamagingMove", "args": ["?actorPokemon"]}
      ],
      "conclusion": {
        "predicate": "PokemonActionIntent",
        "args": ["?actorPokemon", "?targetPokemon", "ATTACK"]
      }
    },
    {
      "id": "P5",
      "description": "Heal a living low-HP Pokémon when it has a healing move.",
      "conditions": [
        {"predicate": "Controls", "args": ["?actor", "?pokemon"]},
        {"predicate": "AlivePokemon", "args": ["?pokemon"]},
        {"predicate": "LowHP", "args": ["?pokemon"]},
        {"predicate": "HasHealingMove", "args": ["?pokemon"]}
      ],
      "conclusion": {
        "predicate": "PokemonActionIntent",
        "args": ["?pokemon", "?pokemon", "HEAL"]
      }
    },
    {
      "id": "G1",
      "description": "Choose a recovery goal for a living low-HP Pokémon with a healing move.",
      "conditions": [
        {"predicate": "Controls", "args": ["?actor", "?pokemon"]},
        {"predicate": "AlivePokemon", "args": ["?pokemon"]},
        {"predicate": "LowHP", "args": ["?pokemon"]},
        {"predicate": "HasHealingMove", "args": ["?pokemon"]}
      ],
      "conclusion": {
        "predicate": "PlanGoal",
        "args": ["?actor", "recover", "?pokemon"]
      }
    },
    {
      "id": "G2",
      "description": "Choose a finish goal for a low-HP opposing Pokémon.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?opponent"]},
        {"predicate": "Controls", "args": ["?opponent", "?pokemon"]},
        {"predicate": "AlivePokemon", "args": ["?pokemon"]},
        {"predicate": "LowHP", "args": ["?pokemon"]}
      ],
      "conclusion": {
        "predicate": "PlanGoal",
        "args": ["?actor", "finish", "?pokemon"]
      }
    },
    {
      "id": "G3",
      "description": "Choose a finish goal when a living teammate has type advantage.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?opponent"]},
        {"predicate": "Controls", "args": ["?actor", "?attacker"]},
        {"predicate": "Controls", "args": ["?opponent", "?pokemon"]},
        {"predicate": "AlivePokemon", "args": ["?attacker"]},
        {"predicate": "AlivePokemon", "args": ["?pokemon"]},
        {"predicate": "HasTypeAdvantage", "args": ["?attacker", "?pokemon"]}
      ],
      "conclusion": {
        "predicate": "PlanGoal",
        "args": ["?actor", "finish", "?pokemon"]
      }
    },
    {
      "id": "G4",
      "description": "Choose a team victory goal while an opponent Pokémon remains alive.",
      "conditions": [
        {"predicate": "Opponent", "args": ["?actor", "?opponent"]},
        {"predicate": "Controls", "args": ["?opponent", "?pokemon"]},
        {"predicate": "AlivePokemon", "args": ["?pokemon"]}
      ],
      "conclusion": {
        "predicate": "PlanGoal",
        "args": ["?actor", "win", "?pokemon"]
      }
    }
  ]
}
